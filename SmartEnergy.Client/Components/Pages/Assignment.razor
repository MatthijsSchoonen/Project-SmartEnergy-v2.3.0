@page "/assignment"
@inject InfluxMeasurementRepository measurementRepository;
@inject SmartMeterConfiguration smartMeterConfiguration;

@rendermode InteractiveServer

@using BlazorExpress.ChartJS



<PageTitle>Opdracht E</PageTitle>

<h1>Opdracht E</h1>
<p>Matthijs Schoonen</p>
<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Fusce sapien sapien, aliquet ut felis ut, viverra volutpat nunc. Nunc blandit tortor mattis nulla molestie fermentum. Curabitur at dolor posuere, eleifend nulla et, ultricies massa. Nulla facilisi. Nunc leo leo, sodales vel lacinia porta, sodales non enim. Maecenas venenatis orci ut lacus bibendum tincidunt. Vestibulum ante ipsum primis in faucibus orci luctus et ultrices posuere cubilia curae; Sed egestas nunc vitae dolor pellentesque elementum. Duis mollis posuere nisl ut euismod. Aliquam erat volutpat. Fusce faucibus porttitor posuere. Mauris ac lectus id turpis ullamcorper ullamcorper ut ut dui. Mauris interdum dui nibh.</p>

<p>
	Werk hier jouw opdracht uit. Schrijf het algoritme en toon de gewenste resultaten op deze pagina.
</p>

<EditForm Model="Form" OnValidSubmit="HandleValidSubmit" FormName="your-form">
	@* Enter your form elements here as input for your algorithm. *@
	<div class="form-group mt-4 col-4">
		<label for="inputGetalInvoer">Getal invoerveld</label>
		<InputNumber class="form-control" id="inputGetalInvoer" placeholder="Voer een Saldeer bedrag in"
					 @bind-Value="Form!.NetMetering" />

	</div>
	<div class="form-group mt-4 col-4">
		<label for="inputDatumInvoer">Datum invoerveld</label>
		<InputDate class="form-control" id="inputDatumInvoer" placeholder="Voer een start datum in"
				   @bind-Value="Form!.StartDate" />

	</div>
	<div class="form-group mt-4 col-4">
		<label for="inputDatumInvoer">Datum invoerveld</label>
		<InputDate class="form-control" id="inputDatumInvoer" placeholder="Voer een eind datum in"
				   @bind-Value="Form!.EndDate" />

	</div>

	
</EditForm>

<hr />

@* The output of your algoritm here *@

<BarChart @ref="barChart" Width="800" OnClick="HandleClickAsync" />

@if (selectedChartItem is not null)
{
	<p class="mt-3 mb-0">
		Selected: @selectedChartItem.DatasetLabel (dataset @selectedChartItem.DatasetIndex),
		@FormatLabel(selectedChartItem) (index @selectedChartItem.Index),
		value @FormatValue(selectedChartItem)
	</p>
}


@code {
	[SupplyParameterFromForm]
	private YourForm? Form { get; set; }



	int meterId; 
	DateTime startDate = DateTime.Now;
	DateTime endDate = DateTime.Now.AddDays(1);
	double netMetering = 0.25;
	static int daysToRetrieve = 7;
	string aggregateWindow = "1h";


	List<string> dayLabels = new List<string>();


	private BarChart barChart = default!;
	private BarChartOptions barChartOptions = default!;
	private ChartData chartData = default!;
	private ChartClickEventArgs? selectedChartItem;

	List<Measurement>? EnergyProducedMeasurements;
	List<Measurement>? EnergyUsedMeasurements;


	/// <summary>
	/// This method is executed when the page is loaded!
	/// </summary>
	protected override void OnInitialized()
	{
		EnergyUsedMeasurements = measurementRepository.GetEnergyConsumed(smartMeterConfiguration.MeterId, daysToRetrieve, aggregateWindow);
		EnergyProducedMeasurements = measurementRepository.GetEnergyProduced(smartMeterConfiguration.MeterId, daysToRetrieve, aggregateWindow);
		Debug.WriteLine("Page loaded!");

		// Initialize form with default values
		if (Form == null)
		{
			Form = new YourForm();
		}


		chartData = new ChartData
		{
			Labels = dayLabels,
			Datasets = new List<IChartDataset>
			{
				new BarChartDataset
				{
					Label = "Energie geproduced",
					Data = GetEnergyProducedData(true),
					BackgroundColor = new List<string> { "#36A2EB" },
				},
					new BarChartDataset
				{
					Label = "Energie gebruikt",
					Data = GetEnergyUsedData(),
					BackgroundColor = new List<string> { "#36A200" },
				},
					new BarChartDataset
				{
					Label = "energie gesaldeerd",
					Data = GetEnergyProducedData(),
					BackgroundColor = new List<string> { "#39A2EB" },
				},
			},
		};

		barChartOptions = new BarChartOptions { Responsive = true };

	}

	public void OnDateChanged()
	{
		int days = (startDate - endDate).Days;
		if (days <= 0)
		{
			daysToRetrieve = 1;
		}
		daysToRetrieve = days;
	}

	/// <summary>
	/// This method is executed when the FORM is posted
	/// </summary>
	public void HandleValidSubmit()
	{
		Debug.WriteLine("Form posted!");

		// Your algorithm here.
	}

	public class YourForm
	{
		// Enter the desired form values here (check the example page on how to make this work)
		public Decimal NetMetering { get; set; } = 0.25M;
		public DateTime? StartDate { get; set; }
		public DateTime? EndDate { get; set; }
	}

	List<double?> GetEnergyProducedData(bool addDayLabels = false){
		List<double?> data = new List<double?>();

		double meterStand = int.MaxValue;
		DateTime day = DateTime.Now.AddYears(-100);


		foreach(Measurement measurement in EnergyProducedMeasurements)
		{
			if(day != measurement.Timestamp.Date)
			{
				day = measurement.Timestamp.Date;
				if(meterStand != int.MaxValue)
				{
					data.Add(measurement.Value - meterStand);
					meterStand = measurement.Value;
				}
				if (addDayLabels)
				{
					dayLabels.Add(measurement.Timestamp.Date.ToString());
				}
			}

			if(meterStand > measurement.Value)
			{
				meterStand = measurement.Value;
			}

			if (EnergyProducedMeasurements.Last() == measurement)
			{
				data.Add(measurement.Value - meterStand);
				meterStand = measurement.Value;
			}
		}

		return data;
	}

	List<double?> GetEnergyUsedData()
	{
		List<double?> data = new List<double?>();
		double meterStand = int.MaxValue;
		DateTime day = DateTime.Now.AddYears(-100);

		foreach (Measurement measurement in EnergyUsedMeasurements)
		{
			if (day != measurement.Timestamp.Date)
			{
				day = measurement.Timestamp.Date;
				if (meterStand != int.MaxValue)
				{
					data.Add(measurement.Value - meterStand);
					meterStand = measurement.Value;
				}
			}

			if (meterStand > measurement.Value)
			{
				meterStand = measurement.Value;
			}

			if (EnergyUsedMeasurements.Last() == measurement)
			{
				data.Add(measurement.Value - meterStand);
				meterStand = measurement.Value;
			}
		}

		return data;
	}

	
	



	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
			await barChart.InitializeAsync(chartData, barChartOptions);

		await base.OnAfterRenderAsync(firstRender);
	}

	private Task HandleClickAsync(ChartClickEventArgs eventArgs)
	{
		selectedChartItem = eventArgs;
		return Task.CompletedTask;
	}

	private static string FormatLabel(ChartClickEventArgs eventArgs) => eventArgs.Label ?? $"item {eventArgs.Index}";

	private static string FormatValue(ChartClickEventArgs eventArgs) => eventArgs.Value?.ToString() ?? "null";
}

	