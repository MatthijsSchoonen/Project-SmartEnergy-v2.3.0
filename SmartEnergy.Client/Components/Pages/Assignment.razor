@page "/assignment"
@inject InfluxMeasurementRepository measurementRepository;
@inject SmartMeterConfiguration smartMeterConfiguration;

@rendermode InteractiveServer

@using BlazorExpress.ChartJS

<PageTitle>Opdracht E</PageTitle>

<h1>Opdracht E</h1>
<h4>Matthijs Schoonen</h4>
<p>Hieronder worden in de staafdiagram de meetwaarden van het energieverbruik en de energieopbrengst weergegeven. In het groen wordt de opbrengst van de zonnepanelen met een dynamisch tarief weergegeven. In het rood wordt het energieverbruik met een vast tarief weergegeven, dat je zelf kunt instellen. Tot slot wordt in het oranje de gesaldeerde energie weergegeven, met hetzelfde tarief als het verbruik. De resultaten zijn per dag en berekend op basis van hele kilowatturen vermenigvuldigd met het energietarief.</p>

<div class="d-flex justify-content-between">
	<EditForm Model="Form" OnValidSubmit="HandleValidSubmit" FormName="your-form" class="d-flex justify-content-between w-50 align-items-end">
		@* Enter your form elements here as input for your algorithm. *@
		
		<div class="form-group primary rounded text-white d-flex justify-content-center align-items-center flex-column h-65">
			<label for="inputDatumInvoer" class="px-3 ">Start Datum</label>
			<InputDate class="form-control w-80 center" id="inputDatumInvoer" placeholder="Voer een start datum in"
					   @bind-Value="Form!.StartDate"  />

		</div>
		<div class="form-group primary rounded text-white d-flex justify-content-center align-items-center flex-column h-65">
			<label for="inputDatumInvoer" class="px-3 ">Eind Datum</label>
			<InputDate class="form-control w-80 center" id="inputDatumInvoer" placeholder="Voer een eind datum in"
					   @bind-Value="Form!.EndDate" />

		</div>

		<div class="form-group primary rounded text-white d-flex justify-content-center align-items-center flex-column h-65">
			<label for="inputGetalInvoer" class="px-3">Energie Tarief per Kwh</label>
			<InputNumber class="form-control w-80 center" id="inputGetalInvoer" placeholder="Voer een Saldeer bedrag in"
						 @bind-Value="Form!.NetMetering" />

		</div>

		<div class="primary rounded d-flex justify-content-center align-items-center h-65 w-30">
			<button type="submit" class="btn text-white border  w-80 ">Herlaad Staafdiagram</button>
		</div>
		
	</EditForm>

	<div class="primary rounded">
		<p class="text-white p-3"><span><Icon Name="IconName.SquareFill"  Color="IconColor.Success"/></span> Energieopbrengst dynamisch tarief</p>
		<p class="text-white p-3"><span><Icon Name="IconName.SquareFill"  Color="IconColor.Danger"/></span> Energieverbruik invoertarief</p>
		<p class="text-white p-3"><span><Icon Name="IconName.SquareFill"  Color="IconColor.Warning"/></span> Energiesaldering invoertarief</p>
	</div>
</div>


<hr />

@* The output of your algoritm here *@

<BarChart @ref="barChart" Height="450" Width="1600" OnClick="HandleClickAsync" />




@code {
	[SupplyParameterFromForm]
	private YourForm? Form { get; set; }
	int meterId; 
	DateTime startDate = DateTime.Now.AddDays(-7).Date;
	DateTime endDate = DateTime.Now.Date;
	decimal netMetering = 0.25m;
	static int daysToRetrieve = 7;
	string aggregateWindow = "15m";
	static List<MeasurementDay> MeasurementDays = new List<MeasurementDay>();


	private BarChart barChart = default!;
	private BarChartOptions barChartOptions = default!;
	private ChartData chartData = default!;
	private ChartClickEventArgs? selectedChartItem;



	///<summary>
	/// method that groups energyProduced en energyUsed measurement per day 
	/// each day has date, energyProduced in KwH and energyUsed in kwH
	///</summary>
	void GetMeasurements()
	{
		MeasurementDays = new List<MeasurementDay>();
		List<Measurement>? energyUsed = measurementRepository.GetEnergyConsumed(smartMeterConfiguration.MeterId, startDate, endDate.AddHours(23).AddMinutes(59).AddSeconds(59), aggregateWindow);
		List<Measurement>? energyProduced = measurementRepository.GetEnergyProduced(smartMeterConfiguration.MeterId, startDate, endDate.AddHours(23).AddMinutes(59).AddSeconds(59), aggregateWindow);

		double meterStandProduced = int.MaxValue;
		double meterStandUsed = int.MaxValue;
		double meterStand = 0;
		decimal energyNetMetered = 0;
		DateTime day = DateTime.Now.AddYears(1000);

		// loop over every measurement in energyProduced 
		// every date in found in energyProduced makes a new record in MeasurementDays
		// energy used gets set to 0 

		foreach (Measurement measurement in energyProduced)
		{
			if (startDate > measurement.Timestamp)
			{
				continue;
			}

			if (meterStand == 0)
				meterStand = measurement.Value;

			if (day != measurement.Timestamp.Date)
			{
				if (meterStandProduced != int.MaxValue)
				{
					MeasurementDays.Add(new(day, measurement.Value - meterStandProduced, 0, energyNetMetered));
					meterStandProduced = measurement.Value;
				}
				//update day and reset netmetering
				day = measurement.Timestamp.Date;
				energyNetMetered = 0;
			}

			if (meterStandProduced > measurement.Value)
			{
				meterStandProduced = measurement.Value;
			}

			if (meterStand < measurement.Value)
			{
				energyNetMetered += (decimal)measurement.EnergyPrice;
				meterStand = measurement.Value;
			}

			if (energyProduced.Last() == measurement || endDate.AddHours(23).AddMinutes(59) < measurement.Timestamp)
			{
				MeasurementDays.Add(new(day, measurement.Value - meterStandProduced, 0, energyNetMetered));
				meterStandProduced = measurement.Value;
				break;
			}
		}

		//reset day to reuse
		day = DateTime.Now.AddYears(1000);

		//loop over every measurement in energyUsed
		//match the date to an record in MeasurementDays 
		// update the energyUsed in the found record in MeasurementDays
		foreach (Measurement measurement in energyUsed)
		{
			if (startDate > measurement.Timestamp)
			{
				continue;
			}


			if (day != measurement.Timestamp.Date)
			{	
				if (meterStandUsed != int.MaxValue)
				{	
					if (MeasurementDays.Where(measurementDay => measurementDay.Date == day).FirstOrDefault() != null)
					{
						MeasurementDays.Where(measurementDay => measurementDay.Date == day).FirstOrDefault().EnergyUsed = measurement.Value - meterStandUsed;
					}

					meterStandUsed = measurement.Value;
				}
				day = measurement.Timestamp.Date;
			}

			if (meterStandUsed > measurement.Value)
			{
				meterStandUsed = measurement.Value;
			}


			if (energyUsed.Last() == measurement || endDate.AddHours(23).AddMinutes(59) < measurement.Timestamp)
			{
				if (MeasurementDays.Where(measurementDay => measurementDay.Date == day).FirstOrDefault() != null)
				{
					MeasurementDays.Where(measurementDay => measurementDay.Date == day).FirstOrDefault().EnergyUsed = measurement.Value - meterStandUsed;
				}
				meterStandUsed = measurement.Value;
				break;
			}
		}
	}

	List<string>? GetReturnDayLabels()
	{
		List<string>? dates = new List<string>();
		foreach (MeasurementDay day in MeasurementDays)
		{
			dates.Add(day.Date.ToShortDateString());
		}
		return dates;
	}

	List<double?> GetEnergyProduced()
	{
		List<double?> producedEnergyDays = new List<double?>();
		foreach (MeasurementDay day in MeasurementDays)
		{
			producedEnergyDays.Add((double)day.EnergyNetMetered);
		}
		return producedEnergyDays;
	}

	List<double?> GetEnergyUsed()
	{
		List<double?> usedEnergyDays = new List<double?>();
		foreach (MeasurementDay day in MeasurementDays)
		{
			usedEnergyDays.Add(day.EnergyUsed * (double)netMetering);
		}
		return usedEnergyDays;
	}

	List<double?> GetNetMetering()
	{
		List<double?> netMeterings = new List<double?>();
		foreach (MeasurementDay day in MeasurementDays)
		{
			netMeterings.Add((day.EnergyUsed - day.EnergyProduced) * (double)netMetering);
		}
		return netMeterings;
	}


	/// <summary>
	/// This method is executed when the page is loaded!
	/// </summary>
	protected override void OnInitialized()
	{
		GetMeasurements();
		Debug.WriteLine("Page loaded!");

		// Initialize form with default values
		if (Form == null)
		{
			Form = new YourForm();
			Form.StartDate = startDate;
			Form.EndDate = endDate;
		}

		LoadBarChart();
	}

	void LoadBarChart()
	{
		chartData = new ChartData
		{
			Labels = GetReturnDayLabels(),
			Datasets = new List<IChartDataset>
			{
				new BarChartDataset
				{
					Label = "Energie geproduceerd met dynamisch tarief €",
					Data = GetEnergyProduced(),
					BackgroundColor = new List<string> { "#198754" },
				},
					new BarChartDataset
				{
					Label = "Energie verbruikt met invoerveld tarief €",
					Data = GetEnergyUsed(),
					BackgroundColor = new List<string> { "#dc3545" },
				},
					new BarChartDataset
				{
					Label = "Energie gesaldeerd met invoerveld tarief €",
					Data = GetNetMetering(),
					BackgroundColor = new List<string> { "#ffc107" },
				},
			},
		};

		barChartOptions = new BarChartOptions { Responsive = true };
		barChartOptions.Plugins.Legend.Display = false;
	}



	/// <summary>
	/// This method is executed when the FORM is posted
	/// </summary>
	public void HandleValidSubmit()
	{
		Debug.WriteLine("Form posted!");

		// Your algorithm here.

		if (Form?.NetMetering == null || Form?.NetMetering == 0)
			Form.NetMetering = netMetering;

		if (Form?.StartDate == null)
			Form?.StartDate = startDate;

		if (Form?.EndDate == null)
			Form?.EndDate = endDate;

		if (Form?.EndDate <= Form?.StartDate)
			Form.EndDate = Form.StartDate.AddDays(1);

		netMetering = Form.NetMetering;
		startDate = Form.StartDate;
		endDate = Form.EndDate.Date;;


		GetMeasurements();
		LoadBarChart();
		barChart.UpdateAsync(chartData, barChartOptions);
	}

	public class YourForm
	{
		// Enter the desired form values here (check the example page on how to make this work)
		public Decimal NetMetering { get; set; } = 0.25M;
		public DateTime StartDate { get; set; }
		public DateTime EndDate { get; set; }
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
			await barChart.InitializeAsync(chartData, barChartOptions);

		await base.OnAfterRenderAsync(firstRender);
	}

	private Task HandleClickAsync(ChartClickEventArgs eventArgs)
	{
		selectedChartItem = eventArgs;
		return Task.CompletedTask;
	}

	private static string FormatLabel(ChartClickEventArgs eventArgs) => eventArgs.Label ?? $"item {eventArgs.Index}";

	private static string FormatValue(ChartClickEventArgs eventArgs) => eventArgs.Value?.ToString() ?? "null";

	public class MeasurementDay
	{
		public MeasurementDay(DateTime date, double energyProduced, double energyUsed, decimal energyNetMetered)
		{
			this.Date = date;
			this.EnergyProduced = energyProduced;
			this.EnergyUsed = energyUsed;
			this.EnergyNetMetered = energyNetMetered;
		}

		public DateTime Date { get; set; }
		public double EnergyProduced { get; set; }
		public double EnergyUsed { get; set; }
		public decimal EnergyNetMetered { get; set; }
	}
}

